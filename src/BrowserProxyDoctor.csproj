<?xml version="1.0" encoding="utf-8"?>
<Project ToolsVersion="15.0" DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">x64</Platform>
    <OutputType>WinExe</OutputType><RootNamespace>BrowserProxyDoctor</RootNamespace>
    <AssemblyName>BrowserProxyDoctor</AssemblyName><TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <PlatformTarget>x64</PlatformTarget><LangVersion>5</LangVersion>
    <OutputPath>bin\$(Configuration)\</OutputPath><Optimize>true</Optimize>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <AppConfig>BrowserProxyDoctor.exe.config</AppConfig>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System"/><Reference Include="System.Core"/><Reference Include="System.Drawing"/>
    <Reference Include="System.Windows.Forms"/><Reference Include="System.Management"/>
    <Reference Include="System.Web.Extensions"/><Reference Include="System.Net.Http"/>
  </ItemGroup>
  <ItemGroup>
    <Compile Include="AssemblyInfo.cs"/><Compile Include="Program.cs"/><Compile Include="NativeProxy.cs"/><Compile Include="Services.cs"/>
    <Compile Include="Diagnostics.cs"/><Compile Include="MainForm.cs"/><Compile Include="Tests.cs"/>
    <None Include="BrowserProxyDoctor.exe.config"/><None Include="app.manifest"/><None Include="build.ps1"/>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets"/>
</Project>
